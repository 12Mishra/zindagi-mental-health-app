{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "therapist",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "therapist", "run", "dev"],
      "port": 3200
    },
    {
      "name": "admin",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "admin", "run", "dev"],
      "port": 3100
    },
    {
      "name": "mobile-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "mobile", "run", "web"],
      "env": { "CI": "1", "BROWSER": "none", "NODE_OPTIONS": "--max-old-space-size=6144" },
      "port": 8082
    },
    {
      "name": "expo-web",
      "url": "http://localhost:8081"
    }
  ]
}
