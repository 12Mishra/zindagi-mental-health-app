{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://source-coral-garcia-tuition.trycloudflare.com",
        "EXPO_PUBLIC_VOICE_WS_URL": "wss://midwest-charity-rebel-corps.trycloudflare.com/voice"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://source-coral-garcia-tuition.trycloudflare.com",
        "EXPO_PUBLIC_VOICE_WS_URL": "wss://midwest-charity-rebel-corps.trycloudflare.com/voice"
      }
    },
    "production": {
      "autoIncrement": true
    }
  }
}
