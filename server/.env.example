# Create a fresh isolated PostgreSQL database named zindagi_voice_dev first.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/zindagi_voice_dev
PORT=4000
VOICE_PORT=4001
VOICE_ALLOWED_ORIGINS=http://localhost:8082
VOICE_MAX_CONVERSATIONS=1
VOICE_MAX_SESSION_MINUTES=30
SUMMARY_CONCURRENCY=1
SUMMARY_POLL_MS=2000
# Leave these blank to use OLLAMA_MODEL for summaries through Ollama's JSON mode.
SUMMARY_LLM_BASE_URL=
SUMMARY_LLM_API_KEY=
SUMMARY_LLM_MODEL=

# Explicitly provision and approve provider accounts before using live student data.
DEEPGRAM_API_KEY=
SARVAM_API_KEY=sk_ibtlce37_XkEXgIHIKWTOPkBVCMmqEFZ0
VOICE_LLM_BASE_URL=http://127.0.0.1:8081/v1
VOICE_LLM_API_KEY=60cf141c31d852152aaec61dc9286571d456afa5e7c671a647637f7a0b724d0a
VOICE_LLM_MODEL=lisa
VOICE_LLM_MAX_TOKENS=120
# Empty = the served model's own default (e.g. the Lisa Modelfile).
VOICE_LLM_TEMPERATURE=
VOICE_LLM_WARMUP=true
# Required: a separately tested, fast safety checker. It never falls back to the Lisa endpoint.
VOICE_SAFETY_BASE_URL=
VOICE_SAFETY_API_KEY=
VOICE_SAFETY_MODEL=
VOICE_SAFETY_TIMEOUT_MS=1800
VOICE_SAFETY_REASONING_EFFORT=
# Max wait for LLM triage before releasing Lisa audio on regex-LOW turns; a late non-LOW verdict cuts playback.
VOICE_TRIAGE_GATE_MS=350
# async = audit each released clause in the background (BLOCK cuts playback) | off
VOICE_OUTPUT_REVIEW=async
# ws = persistent Sarvam streaming socket | http = per-clause HTTP stream fallback
TTS_TRANSPORT=ws
TTS_SPEAKER=shubh
STT_ENDPOINTING_MS=300
BARGE_IN_MIN_WORDS=2

# Enter current approved rates to enable rough per-turn/session estimates.
COST_STT_USD_PER_MINUTE=0
COST_TTS_USD_PER_1000_CHARS=0
COST_LLM_INPUT_USD_PER_MILLION_TOKENS=0
COST_LLM_OUTPUT_USD_PER_MILLION_TOKENS=0

# For the existing Lisa GGUF, see training/README.md. OLLAMA_MODEL also serves legacy typed chat and summaries.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=lisa
AUTH_OTP_CODE=1234
