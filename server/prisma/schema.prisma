// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Sex {
  FEMALE
  MALE
  NON_BINARY
  PREFER_NOT_TO_SAY
}

model User {
  id          String   @id @default(uuid())
  phoneNumber String   @unique
  fullName    String
  age         Int
  college     String
  sex         Sex
  history     String[] @default([]) // deprecated: superseded by UserMemory (still written by the auth flow)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // P3 portals: tenant, cohort attributes and the pseudonym shown to staff instead of identity.
  institutionId String?
  institution   Institution? @relation(fields: [institutionId], references: [id], onDelete: SetNull)
  yearOfStudy   Int?
  department    String?
  pseudonym     String?      @unique
  checkinOptIn  Boolean      @default(false)

  checkins     MoodCheckin[]
  appointments Appointment[]
  outreach     Outreach[]

  otpRequests     OtpRequest[]
  sessions        Session[]
  conversations   Conversation[]
  customerProfile CustomerProfile?
  memory          UserMemory?
  memorySummaries MemorySummary[]
  riskHistory     RiskHistory[]
  observations    ProfileObservation[]

  @@index([phoneNumber])
  @@index([institutionId])
}

model OtpRequest {
  id          String    @id @default(uuid())
  phoneNumber String
  otpHash     String
  consumedAt  DateTime?
  expiresAt   DateTime
  createdAt   DateTime  @default(now())

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([phoneNumber, createdAt])
}

model Session {
  id         String    @id @default(uuid())
  tokenHash  String    @unique
  userAgent  String?
  ipAddress  String?
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())

  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  voiceTickets VoiceTicket[]

  @@index([userId])
  @@index([expiresAt])
}

enum ConversationStatus {
  ACTIVE
  ENDED
}

enum MessageRole {
  USER
  ASSISTANT
}

model Conversation {
  id                String               @id @default(uuid())
  userId            String
  user              User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  status            ConversationStatus   @default(ACTIVE)
  moodBefore        String[]             @default([])
  moodNote          String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  endedAt           DateTime?
  transcriptConsent Boolean              @default(false)
  memoryConsent     Boolean              @default(false)
  languageHint      String?
  topics            Topic[]              @default([])
  retentionUntil    DateTime?
  nextTurnNumber    Int                  @default(1)
  messages          Message[]
  summary           ConversationSummary?
  summaryJob        SummaryJob?
  voiceTickets      VoiceTicket[]
  riskEvents        RiskEvent[]
  responseReviews   ResponseReview[]
  observations      ProfileObservation[]
  memorySummary     MemorySummary?
  riskHistory       RiskHistory[]

  @@index([userId, createdAt])
  @@index([retentionUntil])
}

enum DeliveryStatus {
  PENDING
  DELIVERED
  INTERRUPTED
}

model Message {
  id               String         @id @default(uuid())
  conversationId   String
  conversation     Conversation   @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role             MessageRole
  content          String
  turnNumber       Int
  clientTurnId     String?
  deliveryStatus   DeliveryStatus @default(DELIVERED)
  deliveredContent String?
  createdAt        DateTime       @default(now())

  @@unique([conversationId, turnNumber])
  @@unique([conversationId, clientTurnId, role])
  @@index([conversationId, turnNumber])
}

model ConversationSummary {
  id             String       @id @default(uuid())
  conversationId String       @unique
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  summary        String
  keyThemes      String[]
  createdAt      DateTime     @default(now())
  structured     Json?
  policyVersion  String?
}

enum SummaryJobState {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

model SummaryJob {
  id             String          @id @default(uuid())
  conversationId String          @unique
  conversation   Conversation    @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  state          SummaryJobState @default(PENDING)
  attempts       Int             @default(0)
  leaseOwner     String?
  leaseUntil     DateTime?
  nextAttemptAt  DateTime        @default(now())
  lastErrorCode  String?
  payload        Json? // Redis session snapshot for memory-only sessions (no transcript)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([state, nextAttemptAt])
  @@index([leaseUntil])
}

model VoiceTicket {
  id             String       @id @default(uuid())
  tokenHash      String       @unique
  userId         String
  sessionId      String
  session        Session      @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  expiresAt      DateTime
  consumedAt     DateTime?
  createdAt      DateTime     @default(now())

  @@index([expiresAt])
}

enum RiskLevel {
  UNKNOWN
  LOW
  ELEVATED
  URGENT
}

model RiskEvent {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  turnId         String
  level          RiskLevel
  evidence       String?
  action         String
  policyVersion  String
  createdAt      DateTime     @default(now())

  @@unique([conversationId, turnId, policyVersion])
}

enum ReviewDecision {
  ALLOW
  BLOCK
  REVISE
  UNKNOWN
}

model ResponseReview {
  id             String         @id @default(uuid())
  conversationId String
  conversation   Conversation   @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  generationId   String
  segmentIndex   Int
  decision       ReviewDecision
  reasonCode     String
  policyVersion  String
  createdAt      DateTime       @default(now())

  @@unique([conversationId, generationId, segmentIndex])
}

enum Kosha {
  ANNAMAYA
  PRANAMAYA
  MANOMAYA
  VIJNANAMAYA
  ANANDAMAYA
}

model ProfileObservation {
  id             String        @id @default(uuid())
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversationId String?
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  kosha          Kosha
  observation    String
  evidenceTurnId String
  policyVersion  String
  supersededAt   DateTime?
  createdAt      DateTime      @default(now())

  @@index([userId, kosha, createdAt])
}

// deprecated: replaced by UserMemory + RiskHistory, drop in P7
model CustomerProfile {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  keywords  String[] @default([])
  themes    String[] @default([])
  riskFlags String[] @default([])
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

model UserMemory {
  userId      String   @id
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  memoryCard  String   @default("")
  openThreads Json     @default("[]")
  preferences Json     @default("{}")
  version     Int      @default(0)
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())
}

// Survives transcript deletion; embedding is empty when embeddings are not configured.
model MemorySummary {
  id               String        @id @default(uuid())
  userId           String
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversationId   String?       @unique
  conversation     Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  summary          String
  keyThemes        String[]
  language         String?
  embedding        Float[]       @default([])
  sessionStartedAt DateTime
  createdAt        DateTime      @default(now())

  @@index([userId, sessionStartedAt])
}

// Append-only, never overwritten.
model RiskHistory {
  id             String        @id @default(uuid())
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversationId String?
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  level          RiskLevel
  flag           String
  evidenceTurnId String?
  policyVersion  String
  createdAt      DateTime      @default(now())

  @@index([userId, createdAt])
}

// ───────────────────────── P3: admin and therapist portals ─────────────────────────

enum Topic {
  ACADEMIC
  ANXIETY
  RELATIONSHIPS
  FINANCIAL
  FAMILY
  SLEEP
  CAREER
  HEALTH
  OTHER
}

model Institution {
  id            String   @id @default(uuid())
  name          String
  slug          String   @unique
  kAnonymity    Int      @default(10)
  pseudonymSalt String
  createdAt     DateTime @default(now())

  users  User[]
  staff  StaffUser[]
  stats  CohortDailyStat[]
  alerts Alert[]
}

enum StaffRole {
  ADMIN
  THERAPIST
}

model StaffUser {
  id            String      @id @default(uuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  email         String      @unique
  passwordHash  String
  role          StaffRole
  displayName   String
  active        Boolean     @default(true)
  createdAt     DateTime    @default(now())

  sessions     StaffSession[]
  profile      TherapistProfile?
  slots        AvailabilitySlot[]
  appointments Appointment[]

  @@index([institutionId, role])
}

model StaffSession {
  id          String    @id @default(uuid())
  staffUserId String
  staff       StaffUser @relation(fields: [staffUserId], references: [id], onDelete: Cascade)
  tokenHash   String    @unique
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([staffUserId])
  @@index([expiresAt])
}

enum CheckinSource {
  APP
  WHATSAPP
}

model MoodCheckin {
  id           String        @id @default(uuid())
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  score        Int // 1 (very low) .. 5 (very good)
  tags         String[]      @default([])
  note         String?
  source       CheckinSource @default(APP)
  severity     RiskLevel? // set by the worker's severity classifier when a note exists
  classifiedAt DateTime?
  createdAt    DateTime      @default(now())

  @@index([userId, createdAt])
  @@index([createdAt])
}

// Precomputed aggregates; one row per (institution, day, cohort, metric). Holds no personal data.
model CohortDailyStat {
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  day           DateTime    @db.Date
  cohortKey     String // all | year:N | dept:CODE
  metric        String
  value         Float
  n             Int
  updatedAt     DateTime    @updatedAt

  @@id([institutionId, day, cohortKey, metric])
  @@index([institutionId, cohortKey, metric, day])
}

enum AlertKind {
  RISK
  DISENGAGEMENT
  COHORT_DIP
}

enum AlertSeverity {
  LOW
  MEDIUM
  HIGH
}

enum AlertStatus {
  NEW
  ACK
  RESOLVED
}

model Alert {
  id               String        @id @default(uuid())
  institutionId    String
  institution      Institution   @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  kind             AlertKind
  severity         AlertSeverity
  status           AlertStatus   @default(NEW)
  dedupeKey        String        @unique
  subjectUserId    String? // internal only: never returned by the admin API
  subjectPseudonym String?
  cohortKey        String?
  occurrences      Int           @default(1)
  message          String
  assigneeId       String?
  firstSeenAt      DateTime      @default(now())
  lastSeenAt       DateTime      @default(now())
  resolvedAt       DateTime?

  outreach Outreach[]

  @@index([institutionId, status, lastSeenAt])
}

model Outreach {
  id          String    @id @default(uuid())
  alertId     String
  alert       Alert     @relation(fields: [alertId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  message     String
  createdAt   DateTime  @default(now())
  seenAt      DateTime?
  dismissedAt DateTime?

  @@index([userId, createdAt])
}

model TherapistProfile {
  staffUserId String    @id
  staff       StaffUser @relation(fields: [staffUserId], references: [id], onDelete: Cascade)
  languages   String[]  @default([])
  specialties Topic[]   @default([])
  bio         String?
}

enum SlotStatus {
  OPEN
  BOOKED
  REMOVED
}

enum SessionMode {
  IN_PERSON
  PHONE
  VIDEO
}

model AvailabilitySlot {
  id          String      @id @default(uuid())
  therapistId String
  therapist   StaffUser   @relation(fields: [therapistId], references: [id], onDelete: Cascade)
  startsAt    DateTime
  endsAt      DateTime
  mode        SessionMode @default(IN_PERSON)
  status      SlotStatus  @default(OPEN)

  appointments Appointment[]

  @@index([therapistId, startsAt])
  @@index([status, startsAt])
}

enum AppointmentStatus {
  CONFIRMED
  COMPLETED
  NO_SHOW
  CANCELLED_STUDENT
  CANCELLED_THERAPIST
}

model Appointment {
  id            String            @id @default(uuid())
  slotId        String
  slot          AvailabilitySlot  @relation(fields: [slotId], references: [id])
  studentId     String
  student       User              @relation(fields: [studentId], references: [id], onDelete: Cascade)
  therapistId   String
  therapist     StaffUser         @relation(fields: [therapistId], references: [id], onDelete: Cascade)
  institutionId String
  status        AppointmentStatus @default(CONFIRMED)
  sessionCode   String            @unique
  reason        Topic?
  alertId       String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  consents ConsentGrant[]
  brief    CareBrief?
  notes    TherapistNote[]

  @@index([therapistId, status])
  @@index([studentId, status])
}

enum ConsentScope {
  BRIEF
  IDENTITY
  CONTACT
}

model ConsentGrant {
  id            String       @id @default(uuid())
  appointmentId String
  appointment   Appointment  @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  scope         ConsentScope
  grantedAt     DateTime     @default(now())
  revokedAt     DateTime?

  @@unique([appointmentId, scope])
}

// Frozen snapshot of what the student agreed to share at booking time.
model CareBrief {
  appointmentId String      @id
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  content       Json
  generator     String // llm | fallback
  generatedAt   DateTime    @default(now())
}

model TherapistNote {
  id            String      @id @default(uuid())
  appointmentId String
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  authorId      String
  ciphertext    String
  iv            String
  tag           String
  createdAt     DateTime    @default(now())

  @@index([appointmentId, createdAt])
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String
  actorRole  String
  action     String
  targetType String
  targetId   String
  at         DateTime @default(now())

  @@index([targetType, targetId])
  @@index([actorId, at])
}
