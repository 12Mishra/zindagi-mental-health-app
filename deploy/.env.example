# Infrastructure settings for the deploy/ stack. Copy to deploy/.env and fill in.
# Application config (model endpoint, STT/TTS keys, OTP, encryption keys) stays in server/.env.

# Database superuser password for the internal Postgres. Generate one: openssl rand -base64 24
POSTGRES_PASSWORD=change-me-to-a-long-random-string

# Let's Encrypt account address (expiry notices only).
ACME_EMAIL=you@example.com

# Must already resolve to this VM's public IP before the stack starts, or TLS issuance fails.
API_DOMAIN=api.example.com
VOICE_DOMAIN=voice.example.com

# Only used by the "portals" profile (portals on this VM instead of Freebuff Sites).
ADMIN_DOMAIN=admin.example.com
COUNSELLOR_DOMAIN=counsellor.example.com

# Only for docker-compose.tunnel.yml: install token from Zero Trust -> Networks -> Tunnels.
# Leave empty when Caddy terminates TLS.
TUNNEL_TOKEN=

# Browser origins allowed to call the API and to open the voice socket. Comma separated, no spaces.
# Native apps send no Origin header, so they are unaffected by these. Needed for Expo web
# (`expo start --web` serves on :8082) and for the portals. An empty value here overrides any
# default in the app, so leaving it blank means no browser origin is allowed.
PORTAL_ORIGINS=http://localhost:8082,http://localhost:3100,http://localhost:3200
VOICE_ALLOWED_ORIGINS=http://localhost:8082
