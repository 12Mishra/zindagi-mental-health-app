# Copy to llm.env and adjust. Provider settings for the v2 pipeline (no secrets here). Keys live in training/.env and are referenced by NAME.
TEACHER_BASE_URL=https://openrouter.ai/api/v1
TEACHER_MODEL=openai/gpt-oss-120b
TEACHER_API_KEY_ENV=OPENROUTER_DATA_GENERATION_KEY
TEACHER_REASONING=low
TEACHER_TPM=400000
# Hard stop: generation halts once this run has spent this much (OpenRouter-reported cost).
TEACHER_BUDGET_USD=6.5
JUDGE_BASE_URL=https://api.groq.com/openai/v1
JUDGE_MODEL=qwen/qwen3.8-27b
JUDGE_API_KEY_ENV=CONTEXT_SAVING_LLM_GROQ
JUDGE_TPM=7000
# Per-language teacher for NON-crisis jobs (crisis always uses TEACHER_MODEL). Language names match config/taxonomy.json.
TEACHER_MODEL_BENGALI=qwen/qwen3-235b-a22b-2507
TEACHER_MODEL_BENGALI_ROMAN=qwen/qwen3-235b-a22b-2507
TEACHER_MODEL_PUNJABI=qwen/qwen3-235b-a22b-2507
TEACHER_MODEL_PUNJABI_ROMAN=qwen/qwen3-235b-a22b-2507
