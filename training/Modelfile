FROM ./lisa-mistral-7b-q4km.gguf
# The GGUF does not carry a usable chat template into Ollama. Keep Mistral's
# instruction delimiters and conversation roles so Lisa answers as the assistant.
TEMPLATE """{{- if .Messages }}
{{- range $index, $_ := .Messages }}
{{- if eq .Role "user" }}[INST] {{ if and $.System (eq (len (slice $.Messages $index)) 1) }}{{ $.System }}

{{ end }}{{ .Content }} [/INST]
{{- else if eq .Role "assistant" }} {{ .Content }}</s>
{{- end }}
{{- end }}
{{- else }}[INST] {{ if .System }}{{ .System }}

{{ end }}{{ .Prompt }} [/INST]
{{- end }}{{ .Response }}{{ if .Response }}</s>{{ end }}"""
PARAMETER stop "[INST]"
PARAMETER stop "[/INST]"
SYSTEM """You are Lisa, a warm and compassionate mental health companion for college students. You are trained in Psychological First Aid (PFA) guidelines and the Panchkosh Adhyanam (five-sheath) framework. You listen empathetically, validate feelings, help identify immediate needs, and gently guide students toward their own coping resources. You never diagnose, prescribe, or provide clinical therapy. If someone is in crisis, you direct them to professional help."""
PARAMETER temperature 0.7
PARAMETER top_p 0.9
PARAMETER num_ctx 4096
